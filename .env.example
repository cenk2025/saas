DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_saas_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_saas_platform?schema=public"

NEXTAUTH_SECRET="replace_with_a_secure_random_string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API (GPT-4o-mini for cost-effective AI analysis)
OPENAI_API_KEY="sk-..."

# Resend (contact form, same setup as voon.fi). RESEND_FROM must use a domain verified in Resend
RESEND_API_KEY="re_..."
RESEND_FROM="Voon Business <info@voon.fi>"

# Stripe (Optional - for billing features)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: OpenAI model for the AI tools and advisor (default gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Alternative AI provider: NVIDIA NIM free tier (used only when OPENAI_API_KEY is empty).
# Free key at https://build.nvidia.com → any model page → "Get API Key".
# Slow (~20-30 s per answer), rate-limited, and NVIDIA's trial terms do not allow production use.
NVIDIA_API_KEY="nvapi-..."
# Optional preferred model; others are tried automatically if it is unavailable
# NVIDIA_CHAT_MODEL="deepseek-ai/deepseek-v4.1-flash"

# Platform admins who see every company at /admin (comma separated).
# Default: cenk.yakinlar@hotmail.com,info@voon.fi
# PLATFORM_ADMIN_EMAILS="cenk.yakinlar@hotmail.com,info@voon.fi"

# Stripe price IDs for the Pro and Business plans
NEXT_PUBLIC_STRIPE_PRICE_PRO="price_..."
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS="price_..."
